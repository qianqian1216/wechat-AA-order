/* ========================================
   🌸 创建账本 - 可爱风样式 🌸
   ======================================== */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFE5EC 0%, #FFF5F8 40%, #FFFFFF 100%);
  padding-bottom: 160rpx;
}

/* 引导卡片 */
.guide-card {
  padding: 64rpx 36rpx 48rpx;
  text-align: center;
}

.guide-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.guide-icon { font-size: 56rpx; }

.guide-title {
  font-size: 42rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B9D, #A78BFA);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.guide-desc {
  font-size: 27rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 8rpx;
}

/* 表单卡片 */
.form-card {
  margin: 0 24rpx;
  padding: 34rpx !important;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.field-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: right;
}

/* 提示区域 */
.tips-section { margin: 36rpx 28rpx; }

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tip-num {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B9D, #A78BFA);
  color: #FFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.3);
}

.tip-text {
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 46rpx;
}

/* 授权卡片 */
.auth-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.auth-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.auth-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.auth-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 48rpx;
  padding: 0 20rpx;
}

.auth-tip {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 24rpx;
}

/* 昵称授权输入 */
.nickname-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  max-width: 420rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 16rpx;
  background: #FFF;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid rgba(255, 182, 193, 0.2);
}

.nickname-prefix {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

.nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  min-height: 48rpx;
}

.nickname-hint {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 500;
  margin-bottom: 24rpx;
  display: block;
}

.auth-loading {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

/* 按钮区域 */
.btn-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: linear-gradient(180deg, rgba(255, 245, 248, 0.95), #FFF);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 40rpx rgba(255, 107, 157, 0.12);
  z-index: 100;
}

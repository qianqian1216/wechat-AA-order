<view class="container">
  <!-- 授权检查中 -->
  <view class="auth-loading" wx:if="{{authChecking}}">
    <t-loading theme="circular" size="48rpx" text="检查中..." />
  </view>

  <!-- 授权界面 - 只需昵称 -->
  <block wx:elif="{{!authorized}}">
    <view class="auth-card">
      <view class="auth-icon">📝</view>
      <text class="auth-title">需要你的微信昵称</text>
      <text class="auth-desc">点击下方输入框获取你的微信昵称</text>

      <view class="nickname-wrap">
        <text class="nickname-prefix">昵称：</text>
        <input 
          type="nickname" 
          class="nickname-input"
          placeholder="点此获取微信昵称"
          bind:nicknamereview="onNicknameReview"
          bindblur="onNicknameBlur"
        />
      </view>
      <text class="nickname-hint" wx:if="{{tempNickname}}">✓ 已获取：{{tempNickname}}</text>

      <t-button
        theme="primary"
        size="large"
        block
        bind:tap="onConfirmAuth"
        disabled="{{!tempNickname}}"
      >
        确认授权
      </t-button>
    </view>
  </block>

  <!-- 已授权，显示表单 -->
  <block wx:else>
    <view class="guide-card">
      <view class="guide-header">
        <text class="guide-icon">📖</text>
        <text class="guide-title text-bold">创建新账本</text>
      </view>
      <text class="guide-desc text-tertiary">给你们的摊一下起个名字吧</text>
    </view>

    <view class="card form-card">
      <view class="form-field">
        <text class="field-label">账本名称</text>
        <t-input
          value="{{name}}"
          placeholder="例如：公司团建、周末聚餐、旅行费用..."
          bind:change="onNameInput"
          clearable
          maxlength="20"
          size="large"
        />
        <text class="field-hint text-tertiary">{{name.length}}/20</text>
      </view>
    </view>

    <view class="tips-section">
      <view class="tip-item">
        <text class="tip-num">1</text>
        <text class="tip-text">创建账本后可以添加参与AA的成员</text>
      </view>
      <view class="tip-item">
        <text class="tip-num">2</text>
        <text class="tip-text">账本支持分享给好友查看或共同记账</text>
      </view>
      <view class="tip-item">
        <text class="tip-num">3</text>
        <text class="tip-text">自动计算每个人的应付/已付/差额</text>
      </view>
    </view>

    <view class="btn-area safe-area-bottom">
      <t-button 
        theme="primary" 
        block 
        size="large"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:tap="onSubmit"
      >
        创建账本
      </t-button>
    </view>
  </block>
</view>

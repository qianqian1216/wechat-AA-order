/* ========================================
   🌸 添加账单 - 可爱风样式 🌸
   ======================================== */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFE5EC 0%, #FFF5F8 30%, #FFFFFF 100%);
  padding-bottom: 140rpx;
}

/* 头部 */
.form-header {
  padding: 44rpx 28rpx 26rpx;
  position: relative;
}

.form-header::after {
  content: '✨';
  position: absolute;
  right: 28rpx;
  bottom: 10rpx;
  font-size: 40rpx;
  opacity: 0.4;
}

.header-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: block;
}

.header-subtitle {
  font-size: 25rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  display: block;
}

/* 表单区块 */
.form-section {
  margin: 0 24rpx 18rpx;
  padding: 24rpx !important;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 18rpx;
}

.title-icon { font-size: 34rpx; margin-right: 12rpx; }

.select-count {
  font-size: 25rpx;
  color: var(--primary-color);
  font-weight: 700;
  background: rgba(255, 107, 157, 0.1);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

/* 金额输入框 - 紧凑风格 */
.amount-input-box {
  display: flex;
  align-items: baseline;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #FFF5F8, #FFF9FB);
  border-radius: var(--radius-lg);
  border: 2rpx solid rgba(255, 182, 193, 0.3);
  transition: all 0.25s ease;
}

.amount-input-box.compact {
  flex: 0 0 auto;
  width: 240rpx;
  min-width: 0;
}

.amount-input-box:focus-within {
  border-color: var(--primary-color);
  background: #FFF;
  box-shadow: 0 0 0 6rpx rgba(255, 107, 157, 0.1);
}

.currency-symbol {
  font-size: 34rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B9D, #FF8E72);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.amount-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.2;
  min-width: 0;
}

.amount-placeholder {
  font-size: 32rpx;
  font-weight: 400;
  color: var(--text-placeholder);
}

/* 人均预览 */
.avg-preview {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.preview-icon { font-size: 24rpx; }

.preview-text {
  font-size: 24rpx;
  color: #FFF;
  font-weight: 600;
  background: linear-gradient(135deg, #A78BFA, #C4B5FD);
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  display: inline-block;
}

/* 金额+描述合并行 */
.amount-desc-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 描述输入框 */
.desc-input {
  width: 100%;
  font-size: 29rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, #FFF5F8, #FFF9FB);
  border-radius: var(--radius-md);
  border: 2rpx solid rgba(255, 182, 193, 0.25);
  color: var(--text-primary);
}

.desc-input.inline {
  flex: 1;
  padding: 18rpx 20rpx;
  font-size: 27rpx;
}

.desc-placeholder { color: var(--text-placeholder); }

/* ========================================
   成员选择 - 紧凑风格
   ======================================== */
.member-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.member-option {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 10rpx 12rpx;
  background: linear-gradient(135deg, #FFF9FC, #FFF5F8);
  border-radius: var(--radius-md);
  border: 2rpx solid rgba(255, 182, 193, 0.15);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.member-option.active {
  background: linear-gradient(135deg, #FFE8EF, #FFF0F5);
  border-color: var(--primary-color);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.18);
  transform: translateY(-2rpx) scale(1.02);
}

.member-option:active {
  transform: scale(0.94) translateY(2rpx);
}

.member-avatar-sm {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #FFF;
}

.avatar-char {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFF;
}

.member-name {
  font-size: 22rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.member-option.active .member-name {
  color: var(--primary-color);
  font-weight: 700;
}

/* 右上角勾选图标 */
.check-icon {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #EDEDED;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform: scale(0.5);
}

.check-icon.checked {
  background: linear-gradient(135deg, #FF6B9D, #FF8E72);
  opacity: 1;
  transform: scale(1);
  box-shadow: 0 2rpx 6rpx rgba(255, 107, 157, 0.35);
}

.check-icon text {
  font-size: 18rpx;
  color: #FFF;
  font-weight: 800;
}

/* 快捷操作按钮 */
.quick-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.select-all-btn {
  font-size: 24rpx;
  color: var(--secondary-color);
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.select-all-btn:active {
  color: var(--primary-color);
  background: rgba(255, 107, 157, 0.08);
}

.quick-actions .divider {
  color: var(--border-color);
  font-weight: 300;
}

/* 按钮组 - 一行两个 */
.btn-row {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: linear-gradient(180deg, rgba(255, 245, 248, 0.95), #FFF9FB 50%, #FFF);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 40rpx rgba(255, 107, 157, 0.12);
  z-index: 100;
}

.btn-reset {
  flex: 0 0 auto;
  width: 160rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF5F8, #FFF);
  border-radius: var(--radius-lg);
  border: 2rpx solid rgba(255, 182, 193, 0.4);
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

.btn-reset:active {
  transform: scale(0.95);
  background: #FFE8EF;
}

.btn-submit {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B9D, #FF8E72);
  border-radius: var(--radius-lg);
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 157, 0.35);
  font-size: 29rpx;
  font-weight: 700;
  color: #FFF;
  transition: all 0.2s ease;
}

.btn-submit:active {
  transform: scale(0.97);
  box-shadow: 0 3rpx 12rpx rgba(255, 107, 157, 0.25);
}

.btn-submit.disabled {
  opacity: 0.6;
}

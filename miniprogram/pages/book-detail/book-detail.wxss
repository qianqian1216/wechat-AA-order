/* ========================================
   🌸 账本详情 - 可爱风样式 🌸
   ======================================== */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFE5EC 0%, #FFF5F8 40%, #FFFFFF 100%);
  padding-bottom: env(safe-area-inset-bottom);
}

.loading-wrapper {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

/* ========================================
   头部卡片 - 梦幻渐变
   ======================================== */
.header-card {
  position: relative;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8E72 50%, #A78BFA 100%);
  padding: 56rpx 36rpx 44rpx;
  border-radius: 0 0 48rpx 48rpx;
  overflow: hidden;
}

.header-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.header-card::after {
  content: '💕';
  position: absolute;
  bottom: 24rpx;
  right: 30rpx;
  font-size: 48rpx;
  opacity: 0.25;
}

.header-content {
  position: relative;
  z-index: 2;
}

.book-title {
  font-size: 46rpx;
  font-weight: 800;
  color: #FFF;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.3);
}

.create-time {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
  display: block;
}

/* ========================================
   金额展示 - 可爱气泡风格
   ======================================== */
.amount-section {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16rpx);
  border-radius: var(--radius-xl);
  padding: 28rpx 32rpx;
  margin-top: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.amount-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.amount-row {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.amount-symbol {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF;
  margin-right: 6rpx;
}

.amount-value {
  font-size: 52rpx;
  font-weight: 900;
  color: #FFF;
  letter-spacing: -1rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* ========================================
   总金额 + 成员头像 横排布局
   ======================================== */
.amount-row-combined {
  display: flex;
  flex-direction: column;
}

.amount-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.amount-avatar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

/* ========================================
   成员头像组（横排右侧）
   ======================================== */
.member-avatars {
  gap: -10rpx;
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.avatar-item-sm {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFF;
  margin-left: -10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.avatar-item-sm:first-child { margin-left: 0; }
.avatar-item:active { transform: scale(1.15); }

.avatar-item {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFF;
  margin-left: -14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s ease;
}

.avatar-item:first-child { margin-left: 0; }
.avatar-item:active { transform: scale(1.15); }

.avatar-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFF;
}

.more-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  align-self: center;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 8rpx !important;
}

/* ========================================
   操作栏
   ======================================== */
.action-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 22rpx 16rpx !important;
  background: linear-gradient(135deg, #FFF, #FFF9FC) !important;
  border-radius: var(--radius-xl) !important;
  box-shadow: var(--shadow-sm) !important;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: none !important;
  border: none !important;
  padding: 0 !important;
  line-height: normal !important;
  transition: transform 0.2s ease;
}

.action-item::after { border: none !important; }
.action-item:active { transform: scale(0.92); }

.share-btn { background: none !important; border: none !important; }

.action-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.action-icon.add { 
  background: linear-gradient(135deg, #FF6B9D, #FF8FAB); 
}
.action-icon.member { 
  background: linear-gradient(135deg, #A78BFA, #C4B5FD); 
}
.action-icon.share { 
  background: linear-gradient(135deg, #FFB347, #FFCC80); 
}
.action-icon.settlement { 
  background: linear-gradient(135deg, #A78BFA, #C4B5FD); 
}

.icon-font { font-size: 38rpx; }

.action-text {
  font-size: 23rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.action-divider {
  width: 2rpx;
  height: 56rpx;
  background: linear-gradient(180deg, transparent, #FFE0E8, transparent);
  border-radius: 2rpx;
}

/* 只读提示条 */
.readonly-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin: 16rpx 24rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #FFF5F8, #FFF0F5);
  border-radius: var(--radius-lg);
  border: 2rpx solid rgba(255, 182, 193, 0.2);
}

.readonly-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.readonly-icon { font-size: 28rpx; flex-shrink: 0; }

.readonly-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 添加到我的账本按钮 */
.add-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #FF6B9D, #FF8E72);
  color: #FFFFFF;
  border: none;
  font-size: 22rpx;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  line-height: 1.4;
  font-weight: 600;
  min-width: 120rpx;
  text-align: center;
}

.add-btn::after {
  border: none;
}

.add-btn:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.add-btn.added {
  background: #CCCCCC;
}

.add-done {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #07C160;
  font-weight: 600;
}

/* ========================================
   Tab容器
   ======================================== */
.tab-container {
  margin: 0 24rpx;
  padding: 0 !important;
  border-radius: var(--radius-lg) !important;
  overflow: hidden;
}

/* ========================================
   内容区域
   ======================================== */
.content-area {
  max-height: calc(100vh - 580rpx);
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

/* ========================================
   账单卡片
   ======================================== */
.bill-card {
  margin-bottom: 18rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.25s ease;
  border-left: none !important;
}

.bill-card:active {
  transform: scale(0.98);
}

.bill-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #FF6B9D, #A78BFA);
  border-radius: 4rpx;
}

.bill-desc {
  font-size: 31rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.bill-time {
  font-size: 23rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

.bill-amount {
  font-size: 38rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B9D, #FF8E72);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 账单操作按钮 */
.bill-actions {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.action-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.action-btn:active { transform: scale(0.88); }
.edit-btn { 
  background: linear-gradient(135deg, #E8F0FE, #D4E5FC); 
}
.delete-btn { 
  background: linear-gradient(135deg, #FFE5E5, #FFD4D4); 
}
.btn-icon { font-size: 24rpx; }

.bill-info {
  background: linear-gradient(135deg, #FFF5F8, #FFF0F5);
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid rgba(255, 182, 193, 0.15);
}

.info-row {
  display: flex;
  align-items: center;
}

.info-row.space-between {
  justify-content: space-between;
  width: 100%;
}

.info-left {
  flex: 1;
  min-width: 0;
}

.info-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-left: 20rpx;
  padding: 8rpx 0 8rpx 20rpx;
  border-left: 2rpx solid rgba(255, 182, 193, 0.15);
}

.info-label {
  font-size: 25rpx;
  color: var(--text-secondary);
  margin-right: 10rpx;
  white-space: nowrap;
  font-weight: 500;
}

.participant-tags { gap: 8rpx; }

/* ========================================
   统计卡片 (AA结算) - 紧凑行布局
   ======================================== */
.stat-card-compact {
  margin-bottom: 14rpx;
  padding: 20rpx 24rpx !important;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-left: none !important;
}

.stat-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.stat-avatar-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #FFF;
}

.avatar-text-sm {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFF;
}

.stat-name-sm {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 700;
}

.stat-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stat-col {
  text-align: center;
  padding: 0 12rpx;
  min-width: 100rpx;
}

.stat-col.highlight {
  background: linear-gradient(135deg, #FFF5F8, #FFF0F5);
  border-radius: var(--radius-md);
  padding: 10rpx 16rpx;
  border: 2rpx solid rgba(255, 182, 193, 0.15);
}

.col-label {
  font-size: 21rpx;
  color: var(--text-tertiary);
  display: block;
  font-weight: 500;
}

.col-value {
  font-size: 26rpx;
  font-weight: 800;
  display: block;
  margin-top: 2rpx;
}

.col-value.primary { color: #FF6B9D; }
.col-value.danger { color: #FF4757; }
.col-value.success { color: #2ED573; }

.stat-divider {
  width: 2rpx;
  height: 44rpx;
  background: linear-gradient(180deg, transparent, #E8E0E5, transparent);
}

/* ========== 智能结算方案按钮 - 操作栏风格 ========== */
.suggestion-btn-row {
  padding: 0 24rpx;
  margin-bottom: 14rpx;
}

.suggestion-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx 28rpx;
  background: linear-gradient(135deg, #FFF8E8, #FFFDF5);
  border: 2rpx solid rgba(255, 179, 71, 0.35);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(255, 179, 71, 0.15);
  transition: all 0.25s ease;
  position: relative;
}

.suggestion-action-btn:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(255, 179, 71, 0.1);
}

.action-btn-icon {
  font-size: 32rpx;
}

.action-btn-text {
  font-size: 27rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF8C00, #FFB347);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.action-btn-badge {
  position: absolute;
  top: -8rpx;
  right: -4rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF6B9D, #FF8E72);
  color: #FFF;
  font-size: 20rpx;
  font-weight: 800;
  border-radius: 18rpx;
  padding: 0 10rpx;
  box-shadow: 0 3rpx 10rpx rgba(255, 107, 157, 0.35);
}

/* ========================================
   建议支付方案弹窗
   ======================================== */
.suggestion-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.suggestion-modal.show {
  pointer-events: auto;
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8rpx);
}

.modal-content {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 100%;
  max-height: 75vh;
  transform: translateX(-50%) translateY(100%);
  background: linear-gradient(180deg, #FFF5F8, #FFFFFF);
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -16rpx 60rpx rgba(255, 107, 157, 0.18);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.suggestion-modal.show .modal-content {
  transform: translateX(-50%) translateY(0);
}

/* 弹窗头部 */
.modal-header {
  position: relative;
  padding: 48rpx 36rpx 30rpx;
  text-align: center;
  border-bottom: 2rpx dashed rgba(255, 182, 193, 0.25);
  flex-shrink: 0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: block;
}

.modal-subtitle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  display: block;
}

.modal-close {
  position: absolute;
  top: 32rpx;
  right: 28rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F5F5F5, #EEE);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}

.modal-close:active { transform: scale(0.88); }

/* 弹窗内容区 */
.modal-body {
  flex: 1;
  max-height: calc(75vh - 260rpx);
  padding: 8rpx 24rpx 20rpx;
  box-sizing: border-box;
}

/* ========== 结算方案 - 三列居中卡片 ========== */

.sug-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 22rpx 16rpx;
  margin-bottom: 14rpx;
  background: linear-gradient(135deg, #FFF8E8, #FFFDF5);
  border: 2rpx solid rgba(255, 179, 71, 0.2);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.sug-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 100rpx;
  flex-shrink: 0;
}

.sug-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #FFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.sug-circle text {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFF;
}

.sug-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.sug-mid {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.sug-arrow {
  font-size: 24rpx;
  color: #FFB347;
  font-weight: 700;
}

.sug-amt {
  font-size: 32rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B9D, #FF8E72);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 弹窗底部 */
.modal-footer {
  padding: 20rpx 36rpx calc(env(safe-area-inset-bottom) + 28rpx);
  text-align: center;
  flex-shrink: 0;
}

.settled-tip { padding: 40rpx 0; }

/* 动画 */
.bounce-in {
  animation: bounceIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes bounceIn {
  from { opacity: 0; transform: translateX(-50%) translateY(100%); }
  to   { opacity: 1; }
}

/* ========================================
   删除确认弹窗（与成员管理一致）
   ======================================== */
.delete-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.delete-modal.show {
  pointer-events: auto;
  opacity: 1;
  visibility: visible;
}

.delete-modal .modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8rpx);
}

.delete-modal .modal-dialog {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.85);
  width: 560rpx;
  background: linear-gradient(180deg, #FFF5F8, #FFFFFF);
  border-radius: 40rpx;
  padding: 48rpx 36rpx 0;
  text-align: center;
  box-shadow: 0 20rpx 80rpx rgba(255, 107, 157, 0.25);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.delete-modal.show .modal-dialog {
  transform: translate(-50%, -50%) scale(1);
}

.delete-modal .dialog-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.delete-modal .dialog-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.delete-modal .dialog-desc {
  font-size: 27rpx;
  color: var(--text-secondary);
  display: block;
  line-height: 1.6;
  padding: 0 8rpx;
}

.delete-modal .dialog-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
  padding-bottom: 28rpx;
}

.delete-modal .dialog-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.delete-modal .dialog-btn:active { transform: scale(0.95); }

.delete-modal .dialog-btn.cancel {
  background: linear-gradient(135deg, #F5F5F5, #EEE);
  color: var(--text-secondary);
}

.delete-modal .dialog-btn.confirm {
  background: linear-gradient(135deg, #FF6B9D, #FF8E72);
  color: #FFF;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 157, 0.35);
}
